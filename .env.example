# فقط نمونه‌ی نام متغیرها؛ مقدارهای واقعی را در فایل .env (که وارد Git نمی‌شود) یا GitHub Secrets بگذارید.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@AiNewsPulses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# انتشار واقعی؛ پیش‌فرض خاموش
ENABLE_PUBLISHING=false
DAILY_POST_LIMIT=4
MAX_POSTS_PER_RUN=1
MIN_QUALITY_SCORE=65
MIN_ARTICLE_TEXT_CHARS=800

# تصویر (پیش‌فرض خاموش). فقط برای دامنه‌هایی که مجوز بازنشر تصویرشان را خودتان تأیید کرده‌اید.
ALLOW_ARTICLE_IMAGES=false
IMAGE_ALLOWED_DOMAINS=

DATABASE_PATH=data/ainewspulses.db
LOG_LEVEL=INFO
TIMEZONE=Asia/Tehran
